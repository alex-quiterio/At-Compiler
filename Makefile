#---------------------------------------------------------------
#             CONFIGURE THESE VARIABLES IF NEEDED
#---------------------------------------------------------------

# CDK21 and RTS7 are installed under $(ROOT)/usr (ROOT is empty in the
# Docker image, where they live in /usr).
ROOT =
CDK_INC_DIR = $(ROOT)/usr/include
CDK_LIB_DIR = $(ROOT)/usr/lib
CDK_BIN_DIR = $(ROOT)/usr/bin

LANGUAGE = at

#---------------------------------------------------------------
#                          LAYOUT
#---------------------------------------------------------------
#
#   src/syntax/   scanner and grammar
#   src/ast/      AST nodes
#   src/targets/  visitors (type checker, code generator, ...)
#   build/        everything generated, including the compiler, build/at

SRC   = src
BUILD = build

CXXFLAGS = -std=c++23 -DYYDEBUG=1 -pedantic -Wall -Wextra -ggdb -Wno-unused-parameter \
           -I$(SRC) -I$(BUILD) -I. -I$(CDK_INC_DIR)
LDFLAGS  = -L$(CDK_LIB_DIR) -lcdk

CDK  = $(CDK_BIN_DIR)/cdk
LEX  = flex
YACC = bison

COMPILER = $(BUILD)/$(LANGUAGE)
SCANNER  = $(BUILD)/$(LANGUAGE)_scanner
PARSER   = $(BUILD)/$(LANGUAGE)_parser
AUTO     = $(BUILD)/.auto/all_nodes.h $(BUILD)/.auto/visitor_decls.h

SRC_CPP  = $(SRC)/factory.cpp $(wildcard $(SRC)/targets/*.cpp)
OFILES   = $(SRC_CPP:$(SRC)/%.cpp=$(BUILD)/%.o) $(SCANNER).o $(PARSER).tab.o

EXAMPLES = $(patsubst examples/%.at,$(BUILD)/examples/%,$(wildcard examples/*.at))

#---------------------------------------------------------------
#                          RULES
#---------------------------------------------------------------

all: $(COMPILER)

$(COMPILER): $(OFILES)
	$(CXX) -o $@ $^ $(LDFLAGS)

# node declarations and visitor methods, generated by CDK from src/ast
$(BUILD)/.auto/all_nodes.h: $(wildcard $(SRC)/ast/*.h)
	@mkdir -p $(@D)
	cd $(SRC) && $(CDK) ast --decls ast --language $(LANGUAGE) > $(CURDIR)/$@

$(BUILD)/.auto/visitor_decls.h: $(wildcard $(SRC)/ast/*.h)
	@mkdir -p $(@D)
	cd $(SRC) && $(CDK) ast --decls target --language $(LANGUAGE) > $(CURDIR)/$@

# one bison run makes both files (a grouped target, so "make -j" runs it once)
$(PARSER).tab.c $(PARSER).tab.h &: $(SRC)/syntax/$(LANGUAGE)_parser.y $(AUTO)
	@mkdir -p $(BUILD)
	$(YACC) -dtv -b $(PARSER) $<

$(SCANNER).cpp: $(SRC)/syntax/$(LANGUAGE)_scanner.l
	@mkdir -p $(BUILD)
	$(LEX) -o $@ $<

$(PARSER).tab.o: $(PARSER).tab.c
	$(CXX) $(CXXFLAGS) -Wno-class-memaccess -c $< -o $@

$(SCANNER).o: $(SCANNER).cpp $(PARSER).tab.h
	$(CXX) $(CXXFLAGS) -c $< -o $@

# every source needs the generated node declarations and token numbers
$(BUILD)/%.o: $(SRC)/%.cpp $(AUTO) $(PARSER).tab.h
	@mkdir -p $(@D)
	$(CXX) $(CXXFLAGS) -c $< -o $@

# compile, assemble and link each program in examples/ into build/examples/
examples: $(EXAMPLES)

$(BUILD)/examples/%: examples/%.at $(COMPILER)
	@mkdir -p $(@D)
	cp $< $(@D)/
	$(COMPILER) $(@D)/$*.at
	yasm -felf -o $@.o $@.asm
	ld -m elf_i386 -o $@ $@.o -L$(CDK_LIB_DIR) -lrts

check: $(COMPILER)
	tests/run.sh

clean:
	$(RM) -r $(BUILD) tests/out

.PHONY: all examples check clean
